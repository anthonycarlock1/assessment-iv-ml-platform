{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "pods.eks.amazonaws.com"
      },
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/eks-cluster-name": "anthony-assessment4-eks",
          "aws:RequestTag/kubernetes-namespace": "recommendations-team",
          "aws:RequestTag/kubernetes-service-account": "recommendations-sagemaker"
        }
      }
    }
  ]
}
