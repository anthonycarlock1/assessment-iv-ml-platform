            "AllTraffic",
            {
              "label": "fraud Invocations"
            }
          ],
          [
            "AWS/SageMaker",
            "Invocation5XXErrors",
            "EndpointName",
            "anthony-assessment4-fraud-sagemaker",
            "VariantName",
            "AllTraffic",
            {
              "label": "fraud Invocation5XXErrors"
            }
          ],
          [
            "AWS/SageMaker",
            "Invocations",
            "EndpointName",
            "anthony-assessment4-forecasting-sagemaker",
            "VariantName",
            "AllTraffic",
            {
              "label": "forecasting Invocations"
            }
          ],
          [
            "AWS/SageMaker",
            "Invocation5XXErrors",
            "EndpointName",
            "anthony-assessment4-forecasting-sagemaker",
            "VariantName",
            "AllTraffic",
            {
              "label": "forecasting Invocation5XXErrors"
            }
          ],
          [
            "AWS/SageMaker",
            "Invocations",
            "EndpointName",
            "anthony-assessment4-recommendations-sagemaker",
            "VariantName",
            "AllTraffic",
            {
              "label": "recommendations Invocations"
            }
          ],
          [
            "AWS/SageMaker",
            "Invocation5XXErrors",
            "EndpointName",
            "anthony-assessment4-recommendations-sagemaker",
            "VariantName",
            "AllTraffic",
            {
              "label": "recommendations Invocation5XXErrors"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "SageMaker model latency (microseconds)",
        "region": "us-east-1",
        "period": 60,
        "stat": "Average",
        "view": "timeSeries",
        "metrics": [
          [
            "AWS/SageMaker",
            "ModelLatency",
            "EndpointName",
            "anthony-assessment4-fraud-sagemaker",
            "VariantName",
            "AllTraffic",
