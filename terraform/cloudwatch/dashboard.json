        "region": "us-east-1",
        "period": 60,
        "stat": "Sum",
        "view": "timeSeries",
        "metrics": [
          [
            "ContainerInsights",
            "pod_number_of_running_containers",
            "ClusterName",
            "anthony-assessment4-eks"
