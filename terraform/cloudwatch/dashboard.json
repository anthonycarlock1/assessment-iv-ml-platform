        "region": "us-east-1",
        "period": 60,
        "stat": "Sum",
        "view": "timeSeries",
        "metrics": [
          [
            "AWS/DynamoDB",
            "ReadThrottleEvents",
            "TableName",
            "anthony-assessment4-prediction-history"
          ],
          [
            "AWS/DynamoDB",
            "WriteThrottleEvents",
            "TableName",
            "anthony-assessment4-prediction-history"
          ]
