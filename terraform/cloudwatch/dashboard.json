    {
      "type": "log",
      "x": 0,
      "y": 18,
      "width": 24,
      "height": 6,
      "properties": {
        "region": "us-east-1",
        "title": "Recent application requests and storage events",
        "view": "table",
        "query": "SOURCE '/aws/containerinsights/anthony-assessment4-eks/application' | fields @timestamp, kubernetes.namespace_name, log_processed.service, log_processed.request_id, log_processed.status, log_processed.event, log | sort @timestamp desc | limit 50"
      }
    }
  ]
