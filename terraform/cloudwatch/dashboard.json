              "label": "fraud ModelLatency"
            }
          ],
          [
            "AWS/SageMaker",
            "ModelLatency",
            "EndpointName",
            "anthony-assessment4-forecasting-sagemaker",
            "VariantName",
            "AllTraffic",
            {
              "label": "forecasting ModelLatency"
            }
          ],
          [
            "AWS/SageMaker",
            "ModelLatency",
            "EndpointName",
            "anthony-assessment4-recommendations-sagemaker",
            "VariantName",
            "AllTraffic",
            {
              "label": "recommendations ModelLatency"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 12,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "API and history write errors",
        "region": "us-east-1",
        "period": 60,
        "stat": "Sum",
        "view": "timeSeries",
        "metrics": [
          [
            "Anthony/Assessment4",
            "Api5xxErrors"
          ],
